# Local app: Neon dev branch / weft_console_test (pooled connection).
DATABASE_URL=postgresql://user:password@dev-host-pooler/weft_console_test?sslmode=require
# Migrations: same dev branch / weft_console_test (direct connection).
DATABASE_MIGRATION_URL=postgresql://user:password@dev-host/weft_console_test?sslmode=require
WEFT_MIGRATION_TARGET=development
# Clerk server key for authorized development/test provisioning only.
CLERK_SECRET_KEY=
# Clerk instance scope for explicit local identity mappings. Keep server-only.
WEFT_CLERK_INSTANCE_ID=
# Canonical Console origin for invitation redirects.
WEFT_APP_ORIGIN=https://console.example.com
# Customer bootstrap CLI is restricted to the disposable development/test DB.
WEFT_PROVISION_TARGET=development
WEFT_PROVISION_OPERATOR=operator@example.com
# Automated tests share this disposable database with local development.
# Stop local app usage before running live tests; never point this at production.
DATABASE_TEST_URL=postgresql://user:password@dev-host/weft_console_test?sslmode=require
# Deployment Production uses production branch / weft_console instead.
# Vercel Production also requires its direct DATABASE_MIGRATION_URL and
# WEFT_MIGRATION_TARGET=production. Preview requires the dev URLs and development.
# See docs/backend/vercel-deployment.md; keep this local file on development.
