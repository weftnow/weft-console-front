# Runtime URL for the explicitly selected development/test Neon branch.
DATABASE_URL=postgresql://user:password@development-host/database?sslmode=require
# Administrative URL for controlled versioned migration application.
DATABASE_MIGRATION_URL=postgresql://user:password@development-host/database?sslmode=require
# Only development or test permits the local migration command.
WEFT_MIGRATION_TARGET=development
# Isolated integration suite only; never use a production or shared pilot URL.
DATABASE_TEST_URL=postgresql://user:password@test-host/database?sslmode=require
